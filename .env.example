# DeepSeek Harness Configuration

# DeepSeek 官方 API Key（如留空则自动开启项目内置的 Mock 教学仿真模式）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek API 基础地址（支持官方 API 或兼容 OpenAI 协议的第三方转发）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 默认使用的模型名称
DEEPSEEK_MODEL=deepseek-chat

# 执行模式: mock (无需网络即可运行) 或 live (请求真实模型)
EXECUTION_MODE=mock

